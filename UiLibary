            local optsPad = Instance.new("UIPadding")
            optsPad.PaddingTop    = UDim.new(0, 44)
            optsPad.PaddingBottom = UDim.new(0, 5)
            optsPad.Parent        = wrapper

            local totalH = 42
            local function BuildOptions(list)
                for _, ch in ipairs(wrapper:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                totalH = 42
                for _, opt in ipairs(list) do
                    local ob = Instance.new("TextButton")
                    ob.BackgroundColor3 = C.SurfaceTop
                    ob.BorderSizePixel  = 0
                    ob.Size             = UDim2.new(0, 350, 0, 30)
                    ob.Font             = Enum.Font.GothamSemibold
                    ob.Text             = opt
                    ob.TextColor3       = C.TextMuted
