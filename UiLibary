        -- *** FIX: SelectThis now ONLY iterates ScrollingFrames in PagesHolder
        -- and ONLY TextButtons in TabSide, so UIListLayout / UIPadding /
        -- the divider Frame etc. are never accidentally tweened or toggled.
        local function SelectThis()
            -- Hide all pages
            for _, p in ipairs(PagesHolder:GetChildren()) do
                if p:IsA("ScrollingFrame") then
                    p.Visible = false
                end
            end
            -- Deactivate all tab buttons
            for _, b in ipairs(TabSide:GetChildren()) do
                if b:IsA("TextButton") then
                    Tween(b, {BackgroundColor3 = C.Bg, TextColor3 = C.TextDim}, 0.16)
                    -- Hide this button's named Indicator
                    local ind = b:FindFirstChild("Indicator")
                    if ind then
                        Tween(ind, {Size = UDim2.new(0, 0, 0.7, 0)}, 0.16)
                    end
                end
            end
            -- Show this page and activate this button
            Page.Visible = true
            Tween(TabBtn,    {BackgroundColor3 = C.SurfaceUp, TextColor3 = C.Text}, 0.18)
            Tween(Indicator, {Size = UDim2.new(0, 3, 0.7, 0)}, 0.22, Enum.EasingStyle.Back)
            SyncCanvas()
        end

        TabBtn.MouseButton1Click:Connect(SelectThis)
        TabBtn.MouseEnter:Connect(function()
            if Page.Visible then return end
            Tween(TabBtn, {BackgroundColor3 = C.SurfaceUp}, 0.14)
        end)
        TabBtn.MouseLeave:Connect(function()
            if Page.Visible then return end
            Tween(TabBtn, {BackgroundColor3 = C.Bg}, 0.14)
        end)

        -- *** FIX: auto-select the very first tab that is created.
        -- task.defer so all tabs are parented before we select.
        if not firstTabChosen then
            firstTabChosen = true
            task.defer(SelectThis)
        end

