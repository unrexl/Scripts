            layout.Parent              = wrapper

            local pad = Instance.new("UIPadding")
            pad.PaddingTop    = UDim.new(0, 44)
            pad.PaddingBottom = UDim.new(0, 5)
            pad.Parent        = wrapper

            local totalH = 42
            for _, opt in ipairs(options) do
                local row = Instance.new("Frame")
                row.BackgroundColor3 = C.SurfaceTop
                row.BorderSizePixel  = 0
                row.Size             = UDim2.new(0, 350, 0, 30)
                row.Parent           = wrapper
                Corner(row, 5)

                local box = Instance.new("Frame")
                box.BackgroundColor3 = selected[opt] and C.Accent or C.SurfaceUp
                box.BorderSizePixel  = 0
                box.AnchorPoint      = Vector2.new(0, 0.5)
                box.Position         = UDim2.new(0, 9, 0.5, 0)
                box.Size             = UDim2.new(0, 14, 0, 14)
                box.Parent           = row
                Corner(box, 3)
                Stroke(box, selected[opt] and C.Accent or C.TextDim, 1)

                local tick = Instance.new("TextLabel")
                tick.BackgroundTransparency = 1
                tick.Size             = UDim2.new(1, 0, 1, 0)
                tick.Font             = Enum.Font.GothamBold
                tick.Text             = "✓"
                tick.TextColor3       = C.White
                tick.TextTransparency = selected[opt] and 0 or 1
                tick.TextSize         = 10
                tick.Parent           = box

                local optLbl = Instance.new("TextLabel")
                optLbl.BackgroundTransparency = 1
                optLbl.Position  = UDim2.new(0, 30, 0, 0)
                optLbl.Size      = UDim2.new(1, -38, 1, 0)
                optLbl.Font      = Enum.Font.GothamSemibold
                optLbl.Text      = opt
                optLbl.TextColor3 = C.TextMuted
                optLbl.TextSize  = 12
                optLbl.TextXAlignment = Enum.TextXAlignment.Left
                optLbl.Parent    = row

                local hitBtn = Instance.new("TextButton")
                hitBtn.BackgroundTransparency = 1
                hitBtn.Size            = UDim2.new(1, 0, 1, 0)
                hitBtn.Text            = ""
                hitBtn.AutoButtonColor = false
                hitBtn.Parent          = row

                checkData[opt] = {box = box, tick = tick}
                totalH = totalH + 33

                hitBtn.MouseButton1Click:Connect(function()
                    if selected[opt] then
                        selected[opt] = nil
                        Tween(box,  {BackgroundColor3 = C.SurfaceUp}, 0.15)
                        Tween(tick, {TextTransparency = 1}, 0.15)
                        for _, s in ipairs(box:GetChildren()) do
                            if s:IsA("UIStroke") then s.Color = C.TextDim end
                        end
                    else
                        selected[opt] = true
                        Tween(box,  {BackgroundColor3 = C.Accent}, 0.15)
                        Tween(tick, {TextTransparency = 0}, 0.15)
                        for _, s in ipairs(box:GetChildren()) do
                            if s:IsA("UIStroke") then s.Color = C.Accent end
                        end
                    end
                    hdrLbl.Text = GetLabel()
                    pcall(callback, selected)
                end)
            end

            local clickHdr = Instance.new("TextButton")
            clickHdr.BackgroundTransparency = 1
            clickHdr.Size            = UDim2.new(1, 0, 1, 0)
            clickHdr.Text            = ""
            clickHdr.AutoButtonColor = false
            clickHdr.ZIndex          = 5
            clickHdr.Parent          = hdr

            clickHdr.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    Tween(arrow,   {Rotation = 180}, 0.2)
                    Tween(wrapper, {Size = UDim2.new(0, 370, 0, totalH + 10)}, 0.25, Enum.EasingStyle.Quint)
                else
                    Tween(arrow,   {Rotation = 0}, 0.2)
                    Tween(wrapper, {Size = UDim2.new(0, 370, 0, 42)}, 0.22, Enum.EasingStyle.Quint)
                end
                task.delay(0.25, SyncCanvas)
            end)

            local API = {}
            function API:Get()
                local r = {}
                for k in pairs(selected) do table.insert(r, k) end
                return r
            end
            function API:Set(opts)
                selected = {}
                for _, o in ipairs(opts) do selected[o] = true end
                for opt, data in pairs(checkData) do
                    if selected[opt] then
                        data.box.BackgroundColor3  = C.Accent
                        data.tick.TextTransparency = 0
                    else
                        data.box.BackgroundColor3  = C.SurfaceUp
                        data.tick.TextTransparency = 1
                    end
                end
                hdrLbl.Text = GetLabel()
                pcall(callback, selected)
            end
            return API
        end

        -- ── KeyBind ────────────────────────────────
        function ElementAPI:KeyBind(cfg)
            cfg = cfg or {}
            local text     = cfg.Text     or "KeyBind"
            local default  = cfg.Default  or Enum.KeyCode.Unknown
            local callback = cfg.Callback or function() end
            local currentKey = default
            local listening  = false
            local card = Card(42)

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Position  = UDim2.new(0, 12, 0, 0)
            lbl.Size      = UDim2.new(1, -130, 1, 0)
            lbl.Font      = Enum.Font.GothamSemibold
            lbl.Text      = text
            lbl.TextColor3 = C.Text
            lbl.TextSize  = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent    = card

            local keyBtn = Instance.new("TextButton")
            keyBtn.BackgroundColor3 = C.SurfaceTop
            keyBtn.BorderSizePixel  = 0
            keyBtn.AnchorPoint      = Vector2.new(1, 0.5)
            keyBtn.Position         = UDim2.new(1, -10, 0.5, 0)
            keyBtn.Size             = UDim2.new(0, 100, 0, 26)
            keyBtn.Font             = Enum.Font.GothamBold
            keyBtn.Text             = currentKey.Name
            keyBtn.TextColor3       = C.Accent
            keyBtn.TextSize         = 12
            keyBtn.AutoButtonColor  = false
            keyBtn.Parent           = card
            Corner(keyBtn, 5)
            local kbStroke = Stroke(keyBtn, C.Accent, 1)

            keyBtn.MouseButton1Click:Connect(function()
                if listening then return end
                listening = true
                keyBtn.Text = ". . ."
                Tween(keyBtn,   {TextColor3 = C.TextMuted}, 0.12)
                Tween(kbStroke, {Color = C.TextMuted},      0.12)
                local conn
                conn = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey  = input.KeyCode
                        keyBtn.Text = input.KeyCode.Name
                        Tween(keyBtn,   {TextColor3 = C.Accent}, 0.15)
                        Tween(kbStroke, {Color = C.Accent},      0.15)
                        listening = false
                        conn:Disconnect()
                    end
                end)
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if processed or listening then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == currentKey then
                        pcall(callback)
                    end
                end
            end)

            local API = {}
            function API:Set(kc) currentKey = kc; keyBtn.Text = kc.Name end
            function API:Get()   return currentKey end
            return API
        end

        -- ── ProgressBar ────────────────────────────
        function ElementAPI:ProgressBar(cfg)
            cfg = cfg or {}
            local text    = cfg.Text    or "Progress"
            local default = cfg.Default or 0
            local max     = cfg.Max     or 100
            local current = math.clamp(default, 0, max)
            local card    = Card(52)

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Position  = UDim2.new(0, 12, 0, 7)
            lbl.Size      = UDim2.new(1, -70, 0, 18)
            lbl.Font      = Enum.Font.GothamSemibold
            lbl.Text      = text
            lbl.TextColor3 = C.Text
            lbl.TextSize  = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent    = card

            local pctLbl = Instance.new("TextLabel")
            pctLbl.BackgroundTransparency = 1
            pctLbl.AnchorPoint  = Vector2.new(1, 0)
            pctLbl.Position     = UDim2.new(1, -12, 0, 7)
            pctLbl.Size         = UDim2.new(0, 50, 0, 18)
            pctLbl.Font         = Enum.Font.GothamBold
            pctLbl.Text         = math.floor((current / max) * 100) .. "%"
            pctLbl.TextColor3   = C.Accent
            pctLbl.TextSize     = 12
            pctLbl.TextXAlignment = Enum.TextXAlignment.Right
            pctLbl.Parent       = card

            local tBg = Instance.new("Frame")
            tBg.BackgroundColor3 = C.SurfaceTop
            tBg.BorderSizePixel  = 0
            tBg.Position         = UDim2.new(0, 12, 0, 35)
            tBg.Size             = UDim2.new(1, -24, 0, 8)
            tBg.Parent           = card
            Corner(tBg, 99)

            local fill = Instance.new("Frame")
            fill.BackgroundColor3 = C.Accent
            fill.BorderSizePixel  = 0
            fill.Size             = UDim2.new(current / max, 0, 1, 0)
            fill.Parent           = tBg
            Corner(fill, 99)

            local API = {}
            function API:Set(v)
                current = math.clamp(v, 0, max)
                local scale = current / max
                Tween(fill, {Size = UDim2.new(scale, 0, 1, 0)}, 0.35, Enum.EasingStyle.Quint)
                pctLbl.Text = math.floor(scale * 100) .. "%"
            end
            function API:Get() return current end
            return API
        end

        -- ── ColorPicker ────────────────────────────
        function ElementAPI:ColorPicker(cfg)
            cfg = cfg or {}
            local text     = cfg.Text     or "Color"
            local default  = cfg.Default  or Color3.fromRGB(210, 0, 36)
            local callback = cfg.Callback or function() end
            local col      = default
            local H, S, V  = Color3.toHSV(col)
            local isOpen   = false

            local wrapper = Instance.new("Frame")
            wrapper.BackgroundColor3 = C.Surface
            wrapper.BorderSizePixel  = 0
            wrapper.Size             = UDim2.new(0, 370, 0, 42)
            wrapper.ClipsDescendants = true
            wrapper.Parent           = Page
            Corner(wrapper, 6)

            local hdrFrame = Instance.new("Frame")
            hdrFrame.BackgroundTransparency = 1
            hdrFrame.Size   = UDim2.new(1, 0, 0, 42)
            hdrFrame.Parent = wrapper

            local hdrLbl = Instance.new("TextLabel")
            hdrLbl.BackgroundTransparency = 1
            hdrLbl.Position  = UDim2.new(0, 12, 0, 0)
            hdrLbl.Size      = UDim2.new(1, -70, 1, 0)
            hdrLbl.Font      = Enum.Font.GothamSemibold
            hdrLbl.Text      = text
            hdrLbl.TextColor3 = C.Text
            hdrLbl.TextSize  = 13
            hdrLbl.TextXAlignment = Enum.TextXAlignment.Left
            hdrLbl.Parent    = hdrFrame

            local preview = Instance.new("Frame")
            preview.BackgroundColor3 = col
            preview.BorderSizePixel  = 0
            preview.AnchorPoint      = Vector2.new(1, 0.5)
            preview.Position         = UDim2.new(1, -12, 0.5, 0)
            preview.Size             = UDim2.new(0, 40, 0, 22)
            preview.Parent           = hdrFrame
            Corner(preview, 5)
            Stroke(preview, C.SurfaceTop, 1)

            local function MakeHSVSlider(label, yOff, initial)
                local rowLbl = Instance.new("TextLabel")
                rowLbl.BackgroundTransparency = 1
                rowLbl.Position  = UDim2.new(0, 12, 0, yOff + 2)
                rowLbl.Size      = UDim2.new(0, 16, 0, 16)
                rowLbl.Font      = Enum.Font.GothamBold
                rowLbl.Text      = label
                rowLbl.TextColor3 = C.TextMuted
                rowLbl.TextSize  = 10
                rowLbl.Parent    = wrapper

                local tBg = Instance.new("Frame")
                tBg.BackgroundColor3 = C.SurfaceTop
                tBg.BorderSizePixel  = 0
                tBg.Position         = UDim2.new(0, 32, 0, yOff + 5)
                tBg.Size             = UDim2.new(1, -88, 0, 8)
                tBg.Parent           = wrapper
                Corner(tBg, 99)

                local fl = Instance.new("Frame")
                fl.BackgroundColor3 = C.Accent
                fl.BorderSizePixel  = 0
                fl.Size             = UDim2.new(initial, 0, 1, 0)
                fl.Parent           = tBg
                Corner(fl, 99)

                local vLbl = Instance.new("TextLabel")
                vLbl.BackgroundTransparency = 1
                vLbl.AnchorPoint = Vector2.new(1, 0)
                vLbl.Position    = UDim2.new(1, -12, 0, yOff + 2)
                vLbl.Size        = UDim2.new(0, 36, 0, 16)
                vLbl.Font        = Enum.Font.GothamBold
                vLbl.Text        = math.floor(initial * 255)
                vLbl.TextColor3  = C.Accent
                vLbl.TextSize    = 10
                vLbl.TextXAlignment = Enum.TextXAlignment.Right
                vLbl.Parent      = wrapper

                local hitArea = Instance.new("TextButton")
                hitArea.BackgroundTransparency = 1
                hitArea.Position         = UDim2.new(0, 32, 0, yOff)
                hitArea.Size             = UDim2.new(1, -88, 0, 18)
                hitArea.Text             = ""
                hitArea.AutoButtonColor  = false
                hitArea.ZIndex           = 5
                hitArea.Parent           = wrapper

                return fl, vLbl, hitArea, tBg
            end

            local hFl, hVl, hHit, hTr = MakeHSVSlider("H", 50,  H)
            local sFl, sVl, sHit, sTr = MakeHSVSlider("S", 76,  S)
            local vFl, vVl, vHit, vTr = MakeHSVSlider("V", 102, V)

            local function Rebuild()
                col = Color3.fromHSV(H, S, V)
                preview.BackgroundColor3 = col
                hFl.BackgroundColor3     = Color3.fromHSV(H, 1, 1)
                pcall(callback, col)
            end

            local function HSVDrag(hitBtn, track, fill_f, valLbl, setter)
                local drag = false
                hitBtn.MouseButton1Down:Connect(function() drag = true end)
                UserInputService.InputChanged:Connect(function(input)
                    if not drag then return end
                    if input.UserInputType == Enum.UserInputType.MouseMovement then
                        local rel = math.clamp(
                            (Mouse.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
                            0, 1
                        )
                        fill_f.Size   = UDim2.new(rel, 0, 1, 0)
                        valLbl.Text   = math.floor(rel * 255)
                        setter(rel)
                        Rebuild()
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        drag = false
                    end
                end)
            end

            HSVDrag(hHit, hTr, hFl, hVl, function(v) H = v end)
            HSVDrag(sHit, sTr, sFl, sVl, function(v) S = v end)
            HSVDrag(vHit, vTr, vFl, vVl, function(v) V = v end)

            local clickHdr = Instance.new("TextButton")
            clickHdr.BackgroundTransparency = 1
            clickHdr.Size            = UDim2.new(1, 0, 1, 0)
            clickHdr.Text            = ""
            clickHdr.AutoButtonColor = false
            clickHdr.ZIndex          = 4
            clickHdr.Parent          = hdrFrame

            clickHdr.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    Tween(wrapper, {Size = UDim2.new(0, 370, 0, 132)}, 0.25, Enum.EasingStyle.Quint)
                else
                    Tween(wrapper, {Size = UDim2.new(0, 370, 0, 42)},  0.22, Enum.EasingStyle.Quint)
                end
                task.delay(0.25, SyncCanvas)
            end)

            local API = {}
            function API:Set(c3)
                col = c3
                H, S, V = Color3.toHSV(c3)
                preview.BackgroundColor3 = c3
                hFl.Size = UDim2.new(H, 0, 1, 0); hVl.Text = math.floor(H*255)
                sFl.Size = UDim2.new(S, 0, 1, 0); sVl.Text = math.floor(S*255)
                vFl.Size = UDim2.new(V, 0, 1, 0); vVl.Text = math.floor(V*255)
            end
            function API:Get() return col end
            return API
        end

        -- ── InputNumber ────────────────────────────
        function ElementAPI:InputNumber(cfg)
            cfg = cfg or {}
            local text     = cfg.Text     or "Number"
            local min      = cfg.Min      or 0
            local max      = cfg.Max      or 500
            local default  = cfg.Default  or min
            local step     = cfg.Step     or 1
            local callback = cfg.Callback or function() end
            local current  = math.clamp(default, min, max)
            local card     = Card(42)

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Position  = UDim2.new(0, 12, 0, 0)
            lbl.Size      = UDim2.new(1, -170, 1, 0)
            lbl.Font      = Enum.Font.GothamSemibold
            lbl.Text      = text
            lbl.TextColor3 = C.Text
            lbl.TextSize  = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent    = card

            local minusBtn = Instance.new("TextButton")
            minusBtn.BackgroundColor3 = C.SurfaceTop
            minusBtn.BorderSizePixel  = 0
            minusBtn.AnchorPoint      = Vector2.new(1, 0.5)
            minusBtn.Position         = UDim2.new(1, -10, 0.5, 0)
            minusBtn.Size             = UDim2.new(0, 26, 0, 26)
            minusBtn.Font             = Enum.Font.GothamBold
            minusBtn.Text             = "−"
            minusBtn.TextColor3       = C.TextMuted
            minusBtn.TextSize         = 16
            minusBtn.AutoButtonColor  = false
            minusBtn.Parent           = card
            Corner(minusBtn, 5)

            local valBox = Instance.new("TextBox")
            valBox.BackgroundColor3 = C.SurfaceTop
            valBox.BorderSizePixel  = 0
            valBox.AnchorPoint      = Vector2.new(1, 0.5)
            valBox.Position         = UDim2.new(1, -40, 0.5, 0)
            valBox.Size             = UDim2.new(0, 58, 0, 26)
            valBox.Font             = Enum.Font.GothamBold
            valBox.Text             = tostring(current)
            valBox.TextColor3       = C.Accent
            valBox.TextSize         = 13
            valBox.Parent           = card
            Corner(valBox, 5)

            local plusBtn = Instance.new("TextButton")
            plusBtn.BackgroundColor3 = C.SurfaceTop
            plusBtn.BorderSizePixel  = 0
            plusBtn.AnchorPoint      = Vector2.new(1, 0.5)
            plusBtn.Position         = UDim2.new(1, -102, 0.5, 0)
            plusBtn.Size             = UDim2.new(0, 26, 0, 26)
            plusBtn.Font             = Enum.Font.GothamBold
            plusBtn.Text             = "+"
            plusBtn.TextColor3       = C.Accent
            plusBtn.TextSize         = 16
            plusBtn.AutoButtonColor  = false
            plusBtn.Parent           = card
            Corner(plusBtn, 5)

            local function Apply(v)
                current = math.clamp(v, min, max)
                valBox.Text = tostring(current)
                pcall(callback, current)
            end

            plusBtn.MouseButton1Click:Connect(function()
                Apply(current + step)
                Tween(plusBtn, {BackgroundColor3 = C.AccentDark}, 0.08)
                Tween(plusBtn, {BackgroundColor3 = C.SurfaceTop}, 0.15)
            end)
            minusBtn.MouseButton1Click:Connect(function()
                Apply(current - step)
                Tween(minusBtn, {BackgroundColor3 = C.SurfaceUp}, 0.08)
                Tween(minusBtn, {BackgroundColor3 = C.SurfaceTop}, 0.15)
            end)
            valBox.FocusLost:Connect(function(enter)
                if enter then
                    local n = tonumber(valBox.Text)
                    if n then Apply(n) else valBox.Text = tostring(current) end
                end
            end)

            local API = {}
            function API:Set(v) Apply(v) end
            function API:Get()  return current end
            return API
        end

        -- Alias
        ElementAPI.Bind = ElementAPI.KeyBind

        return ElementAPI
    end -- CreateTab

    return WindowAPI
end -- CreateWindow

return c4rl
