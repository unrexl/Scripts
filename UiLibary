            function API:Get()  return toggled end
            return API
        end

        -- ── Slider ─────────────────────────────────
        function ElementAPI:Slider(cfg)
            cfg = cfg or {}
            local text     = cfg.Text     or "Slider"
            local min      = cfg.Min      or 0
            local max      = cfg.Max      or 100
            local default  = cfg.Default  or min
            local step     = cfg.Step     or 1
            local callback = cfg.Callback or function() end
            local current  = math.clamp(default, min, max)
            local card     = Card(52)

            local textLbl = Instance.new("TextLabel")
            textLbl.BackgroundTransparency = 1
            textLbl.Position  = UDim2.new(0, 12, 0, 7)
            textLbl.Size      = UDim2.new(1, -80, 0, 18)
            textLbl.Font      = Enum.Font.GothamSemibold
            textLbl.Text      = text
            textLbl.TextColor3 = C.Text
            textLbl.TextSize  = 13
            textLbl.TextXAlignment = Enum.TextXAlignment.Left
            textLbl.Parent    = card

            local valLbl = Instance.new("TextLabel")
            valLbl.BackgroundTransparency = 1
            valLbl.AnchorPoint  = Vector2.new(1, 0)
            valLbl.Position     = UDim2.new(1, -12, 0, 7)
            valLbl.Size         = UDim2.new(0, 60, 0, 18)
            valLbl.Font         = Enum.Font.GothamBold
            valLbl.Text         = tostring(current)
            valLbl.TextColor3   = C.Accent
            valLbl.TextSize     = 13
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent       = card

            local tBg = Instance.new("Frame")
            tBg.BackgroundColor3 = C.SurfaceTop
            tBg.BorderSizePixel  = 0
            tBg.Position         = UDim2.new(0, 12, 0, 36)
            tBg.Size             = UDim2.new(1, -24, 0, 6)
            tBg.Parent           = card
            Corner(tBg, 99)

            local fill = Instance.new("Frame")
            fill.BackgroundColor3 = C.Accent
            fill.BorderSizePixel  = 0
            fill.Size             = UDim2.new((current - min) / (max - min), 0, 1, 0)
            fill.Parent           = tBg
            Corner(fill, 99)

            local knob = Instance.new("Frame")
            knob.BackgroundColor3 = C.White
            knob.BorderSizePixel  = 0
            knob.AnchorPoint      = Vector2.new(0.5, 0.5)
            knob.Position         = UDim2.new((current - min) / (max - min), 0, 0.5, 0)
            knob.Size             = UDim2.new(0, 13, 0, 13)
            knob.ZIndex           = 2
            knob.Parent           = tBg
            Corner(knob, 99)
            Stroke(knob, C.AccentDark, 2)

            local hitArea = Instance.new("TextButton")
            hitArea.BackgroundTransparency = 1
            hitArea.BorderSizePixel        = 0
            hitArea.Position               = UDim2.new(0, 12, 0, 28)
            hitArea.Size                   = UDim2.new(1, -24, 0, 22)
            hitArea.Text                   = ""
            hitArea.AutoButtonColor        = false
            hitArea.ZIndex                 = 3
            hitArea.Parent                 = card

            local dragging = false

            local function Calc(mouseX)
                local abs  = tBg.AbsolutePosition.X
                local siz  = tBg.AbsoluteSize.X
                local rel  = math.clamp((mouseX - abs) / siz, 0, 1)
                local raw  = min + (max - min) * rel
                local step_v = math.round(raw / step) * step
                return math.clamp(step_v, min, max), rel
            end

            local function Apply(mouseX)
                local v, rel = Calc(mouseX)
                current = v
                fill.Size     = UDim2.new(rel, 0, 1, 0)
                knob.Position = UDim2.new(rel, 0, 0.5, 0)
                valLbl.Text   = tostring(current)
                pcall(callback, current)
            end

            hitArea.MouseButton1Down:Connect(function()
                dragging = true
                Apply(Mouse.X)
                Tween(knob, {Size = UDim2.new(0, 16, 0, 16)}, 0.1)
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    Apply(Mouse.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    Tween(knob, {Size = UDim2.new(0, 13, 0, 13)}, 0.1)
                end
            end)

            local API = {}
            function API:Set(v)
                current = math.clamp(v, min, max)
                local rel = (current - min) / (max - min)
                fill.Size     = UDim2.new(rel, 0, 1, 0)
                knob.Position = UDim2.new(rel, 0, 0.5, 0)
                valLbl.Text   = tostring(current)
            end
            function API:Get() return current end
            return API
        end

