                    ob.MouseEnter:Connect(function()
                        Tween(ob, {BackgroundColor3 = C.AccentDark, TextColor3 = C.White}, 0.12)
                    end)
                    ob.MouseLeave:Connect(function()
                        Tween(ob, {BackgroundColor3 = C.SurfaceTop, TextColor3 = C.TextMuted}, 0.12)
                    end)
                    ob.MouseButton1Click:Connect(function()
                        selected = opt
                        selectedLbl.Text = text .. ": " .. opt
                        pcall(callback, opt)
                        isOpen = false
                        Tween(arrow,   {Rotation = 0}, 0.2)
                        Tween(wrapper, {Size = UDim2.new(0, 370, 0, 42)}, 0.22, Enum.EasingStyle.Quint)
                        task.delay(0.22, SyncCanvas)
                    end)
                    totalH = totalH + 33
                end
