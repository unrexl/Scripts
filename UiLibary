            BuildOptions(options)

            local clickHdr = Instance.new("TextButton")
            clickHdr.BackgroundTransparency = 1
            clickHdr.Size            = UDim2.new(1, 0, 1, 0)
            clickHdr.Text            = ""
            clickHdr.AutoButtonColor = false
            clickHdr.ZIndex          = 5
            clickHdr.Parent          = hdr

            clickHdr.MouseButton1Click:Connect(function()
