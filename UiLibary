-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
--  Safe GUI Parent
--  Works across Synapse X, KRNL, Fluxus,
--  Electron, Script-Ware, and plain Studio.
-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function GetGuiParent()
    -- gethui() is the safest option for most exploit executors
    if gethui then
        local ok, result = pcall(gethui)
        if ok and result then return result end
    end
    -- syn.protect_gui for Synapse X
    if syn and syn.protect_gui then
        local sg = Instance.new("ScreenGui")
        pcall(syn.protect_gui, sg)
        sg.Parent = game:GetService("CoreGui")
        return sg
    end
    -- Direct CoreGui (works in some executors + Studio)
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    -- Final fallback: PlayerGui (always available)
    return LocalPlayer:WaitForChild("PlayerGui")
end

